e": "test"}]}, {"type": "objectives", "contents": [{"content": " Exchange advice and suggestions in communicative situations.", "type": "primary"}, {"content": " Writes an exchange of written communications about asking for and giving advice on problems with technology or gadgets through the correct use of spelling, grammar, vocabulary, level of formality, cohesion and coherence aspects appropriated to this level. ", "type": "secondary_1"}, {"content": " Writes an exchange of written communications about asking for and giving advice on problems with technology or gadgets through the correct use of spelling, grammar, vocabulary, level of formality, cohesion and coherence aspects appropriated to this level. ", "type": "secondary_2"}, {"content": " Writes an exchange of written communications about asking for and giving advice on problems with technology or gadgets through the correct use of spelling, grammar, vocabulary, level of formality, cohesion and coherence aspects appropriated to this level. ", "type": "secondary_3"}, {"content": " Writes an exchange of written communications about asking for and giving advice on problems with technology or gadgets through the correct use of spelling, grammar, vocabulary, level of formality, cohesion and coherence aspects appropriated to this level. ", "type": "secondary_4"}, {"content": " Writes an exchange of written communications about asking for and giving advice on problems with technology or gadgets through the correct use of spelling, grammar, vocabulary, level of formality, cohesion and coherence aspects appropriated to this level. ", "type": "secondary_5"}, {"content": " Writes an exchange of written communications about asking for and giving advice on problems with technology or gadgets through the correct use of spelling, grammar, vocabulary, level of formality, cohesion and coherence aspects appropriated to this level. ", "type": "secondary_6"}, {"content": " Writes an exchange of written communications about asking for and giving advice on problems with technology or gadgets through the correct use of spelling, grammar, vocabulary, level of formality, cohesion and coherence aspects appropriated to this level. ", "type": "secondary_7"}, {"content": " Writes an exchange of written communications about asking for and giving advice on problems with technology or gadgets through the correct use of spelling, grammar, vocabulary, level of formality, cohesion and coherence aspects appropriated to this level. ", "type": "secondary_8"}]}, {"type": "target_word", "contents": [{"content": "mutual", "type": "name"}, {"content": "shared between two or more people ", "type": "definition"}, {"content": "(adjective)", "type": "part_speech"}, {"content": "Example: Our mutual friend, Vanessa Wright, suggested that I contact you. ", "type": "example"}, {"content": "engenn7le03ob08aud01", "type": "audio"}]}, {"type": "target_word_describer", "contents": [{"content": "These are words you use to describe health issues.", "type": "text"}]}, {"type": "target_word", "contents": [{"content": "physiotherapist", "type": "name"}, {"content": "a person whose job is to improve a person's movement after accident or injury ", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: She says that you have a lot of experience with health issues as a physiotherapist.", "type": "example"}, {"content": "engenn7le03ob08aud02", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "to assure ", "type": "name"}, {"content": " to make something certain", "type": "definition"}, {"content": "(verb)", "type": "part_speech"}, {"content": "Example: The nurses assured me that I would be feeling much better in a couple days.", "type": "example"}, {"content": "engenn7le03ob08aud04", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "to discharge", "type": "name"}, {"content": "to allow (someone) to leave a hospital", "type": "definition"}, {"content": "(verb)", "type": "part_speech"}, {"content": "Example:  I was discharged later that evening.", "type": "example"}, {"content": "engenn7le03ob08aud05", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "to subside", "type": "name"}, {"content": "to become less strong or intense ", "type": "definition"}, {"content": "(verb)", "type": "part_speech"}, {"content": "Example: The pain and swelling has not subsided.", "type": "example"}, {"content": "engenn7le03ob08aud06", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "recovery", "type": "name"}, {"content": "the act or process of becoming healthy after an illness or injury ", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: Could you provide me with some tips or ideas to speed up my recovery? ", "type": "example"}, {"content": "engenn7le03ob08aud07", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "breakthrough", "type": "name"}, {"content": "a sudden increase in knowledge and understanding ", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: Are there any new breakthroughs in medical technology that can help me?", "type": "example"}, {"content": "engenn7le03ob08aud08", "type": "audio"}]}, {"type": "learning_points", "contents": [{"content": "Writing An E-mail To Ask For Help", "type": "heading"}, {"content": "Functional Language", "type": "describer"}, {"content": "When you write a formal e-mail, include:", "type": "text"}, {"content": "<ul><li>an informative subject line, which says what the e-mail is about</li><li>the most important information first</li><li>simple grammar</li><li>short sentences</li><li>formal language</li><li>paragraphs to keep the e-mail clear and easy to understand</li></ul>", "type": "text"}]}, {"type": "learning_points", "contents": [{"content": "Present perfect continuous vs. Present perfect (+ words for duration)", "type": "heading"}, {"content": "You use these tenses  to express that an action began in the past and is still going on or has just finished. ", "type": "describer"}, {"content": "We use the <span class=\"italic\">Present Perfect tense</span> mainly to express that an action is completed or to emphasize the result. ", "type": "text"}, {"content": "Forms:<br/><br/>regular Verbs: form of 'have' + base form + ed<br/><span class=\"italic\">Example: I have worked at the bakery for six years.</span>", "type": "text"}, {"content": "irregular Verbs: form of 'have' +  irregular verb<br/> <span class=\"italic\">Example: I have written a number of books in the last two years.</span>", "type": "text"}, {"content": "We use the <span class=\"italic\">Present Perfect Continuous tense</span> to emphasize the duration or continuous course of an action.", "type": "text"}, {"content": "Form:<br/><br/>form of 'have' + been + verb + ing<br/><span class=\"italic\">Example: We have been walking for two hours!</span>", "type": "text"}, {"content": "Vanessa and I <span class=\"strong\">have been planning</span> a weekend visit to New York <span class=\"strong\">for</span> months. ", "type": "example"}, {"content": " It's a month away now and I <span class=\"strong\">have been getting</span> more and more concerned about my situation.", "type": "example"}, {"content": "Despite the fact that I <span class=\"strong\">have been</span> to a number of doctors <span class=\"strong\">since</span> the accident, nothing seems to be working. ", "type": "example"}]}, {"content": "engenn7le03ob08re1img01.jpg", "type": "background_image"}, {"type": "takeaway_extension", "contents": [{"content": "Write an 80-100 word informal e-mail to a friend about an accident. Choose from the following: slipping on a wet floor, injuring yourself playing a sport, or cutting yourself while cooking", "type": "text"}, {"content": "Describe the injury and your recovery.", "type": "text"}, {"content": "Include contractions and informal language.", "type": "text"}, {"content": "Use adjective to provide rich descriptions.", "type": "text"}, {"content": "Use the Present Perfect tense and the Present Perfect Continuous tense.", "type": "text"}, {"content": "Read your e-mail aloud to a partner.", "type": "text"}]}, {"type": "takeaway_assessment", "contents": [{"content": "I write an informal e-mail about an accident.", "type": "text"}, {"content": "I describe an injury and recovery.", "type": "text"}, {"content": "I use adjectives to provide rich descriptions.", "type": "text"}]}]}